{
  "manifest_version": 3,
  "name": "LifeOS Browser Bridge",
  "version": "1.0.0",
  "description": "Connects LifeOS to the user's open Google Chrome tabs.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["debugger", "nativeMessaging", "storage", "tabs"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "LifeOS Browser Bridge",
    "default_popup": "popup.html"
  }
}
